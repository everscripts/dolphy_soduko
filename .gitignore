# ============================================================

# Android / Kotlin / Gradle .gitignore

# ============================================================

# ------------------------------------------------------------

# Gradle

# ------------------------------------------------------------

.gradle/
**/.gradle/

# Gradle build output

build/
**/build/

# Gradle generated files

.gradle-cache/
.gradletasknamecache

# ------------------------------------------------------------

# Android Studio / IntelliJ IDEA

# ------------------------------------------------------------

.idea/

# IntelliJ project files

*.iml
*.iws
*.ipr

# Workspace files

.idea/workspace.xml
.idea/usage.statistics.xml
.idea/dictionaries/
.idea/shelf/

# Android Studio caches

.idea/caches/
.idea/compiler.xml
.idea/modules.xml
.idea/jarRepositories.xml
.idea/misc.xml
.idea/deploymentTargetSelector.xml
.idea/deploymentTargetDropDown.xml
.idea/deviceManager.xml
.idea/assetWizardSettings.xml

# Android Studio generated files

.idea/navEditor.xml
.idea/preview.xml
.idea/render.experimental.xml

# ------------------------------------------------------------

# Local Android SDK

# ------------------------------------------------------------

local.properties

# ------------------------------------------------------------

# Android Build Outputs

# ------------------------------------------------------------

*/build/
*/out/
out/

# APK files

*.apk
*.ap_
*.aab

# Android Studio generated APK output

output-metadata.json

# ------------------------------------------------------------

# Kotlin

# ------------------------------------------------------------

# Kotlin compiler output

*.class

# Kotlin incremental compilation

.kotlin/

# ------------------------------------------------------------

# Java

# ------------------------------------------------------------

*.class

# ------------------------------------------------------------

# Generated Sources

# ------------------------------------------------------------

generated/
**/generated/

# KSP generated files

**/build/generated/ksp/
**/build/generated/ksp/debug/
**/build/generated/ksp/release/

# KAPT generated files

**/build/generated/source/kapt/
**/build/generated/source/kaptKotlin/

# Data Binding generated files

**/build/generated/data_binding_base_class_source_out/

# Room generated schema output

**/schemas/

# ------------------------------------------------------------

# Android Resources / Generated

# ------------------------------------------------------------

# Generated resource folders

**/build/generated/res/
**/build/generated/source/

# Navigation Safe Args

**/build/generated/source/navigation-args/

# ------------------------------------------------------------

# Signing / Keystores

# ------------------------------------------------------------

# IMPORTANT:

# Never commit private signing keys.

*.jks
*.keystore
*.p12
*.pem

# Signing configuration

keystore.properties

# Local signing files

signing.properties

# ------------------------------------------------------------

# Environment / Secrets

# ------------------------------------------------------------

.env
.env.*
!.env.example

*.secret
*.secrets
secrets.properties
local.properties

# Google service credentials

google-services.json

# Firebase service account credentials

service-account.json
firebase-service-account.json

# Generic credentials

credentials.json
credentials*.json

# Private keys

*.key
*.private

# ------------------------------------------------------------

# Firebase / Google Services

# ------------------------------------------------------------

# Uncomment if you intentionally keep google-services.json

# tracked in your repository:

#

# !app/google-services.json

