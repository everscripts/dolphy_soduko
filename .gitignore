# ============================================================

# IMPORTANT: Files that SHOULD remain tracked

# ============================================================

# Do NOT ignore:

#

# gradle/wrapper/gradle-wrapper.jar

# gradle/wrapper/gradle-wrapper.properties

# gradlew

# gradlew.bat

# settings.gradle.kts

# build.gradle.kts

# app/build.gradle.kts

# gradle/libs.versions.toml

# src/main/

# src/test/

# src/androidTest/

#

# These are normally required for other developers/CI systems.

# ============================================================
